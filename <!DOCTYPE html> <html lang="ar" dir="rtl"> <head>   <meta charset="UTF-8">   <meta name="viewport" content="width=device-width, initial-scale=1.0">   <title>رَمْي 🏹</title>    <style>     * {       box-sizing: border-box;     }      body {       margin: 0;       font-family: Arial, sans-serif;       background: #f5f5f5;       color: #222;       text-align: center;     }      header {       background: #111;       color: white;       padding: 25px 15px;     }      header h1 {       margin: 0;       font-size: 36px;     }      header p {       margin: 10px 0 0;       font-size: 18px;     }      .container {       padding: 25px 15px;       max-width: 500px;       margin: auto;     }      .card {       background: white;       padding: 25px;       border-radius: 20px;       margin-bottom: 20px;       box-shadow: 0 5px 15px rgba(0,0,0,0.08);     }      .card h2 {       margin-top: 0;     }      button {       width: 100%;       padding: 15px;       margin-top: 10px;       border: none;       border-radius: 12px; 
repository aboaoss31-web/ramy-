<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رَمْي 🏹</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
      text-align: center;
    }

    header {
      background: #111;
      color: white;
      padding: 25px 15px;
    }

    header h1 {
      margin: 0;
      font-size: 36px;
    }

    header p {
      margin: 10px 0 0;
      font-size: 18px;
    }

    .container {
      padding: 25px 15px;
      max-width: 500px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 20px;
      margin-bottom: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .card h2 {
      margin-top: 0;
    }

    button {
      width: 100%;
      padding: 15px;
      margin-top: 10px;
      border: none;
      border-radius: 12px;
      background: #111;
      color: white;
      font-size: 18px;
      cursor: pointer;
    }

    button:hover {
      background: #333;
    }

    .score {
      font-size: 40px;
      font-weight: bold;
      margin: 15px;
    }
  </style>
</head>

<body>

  <header>
    <h1>رَمْي 🏹</h1>
    <p>تطبيق تدريب الرماية</p>
  </header>

  <div class="container">

    <div class="card">
      <h2>🎯 ابدأ التدريب</h2>
      <p>اختبر دقتك في الرماية وسجل نقاطك.</p>
      <button onclick="startGame()">ابدأ الآن</button>
    </div>

    <div class="card">
      <h2>🏆 النقاط</h2>
      <div class="score" id="score">0</div>
      <button onclick="addScore()">إضافة نقطة</button>
    </div>

  </div>

  <script>
    let score = 0;

    function startGame() {
      score = 0;
      document.getElementById("score").textContent = score;
      alert("بدأ التدريب 🏹");
    }

    function addScore() {
      score++;
      document.getElementById("score").textContent = score;
    }
  </script>

</body>
</html>
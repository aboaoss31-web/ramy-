<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رَمْي 🏹</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #eef2f3;
      text-align: center;
      color: #222;
    }

    header {
      background: #1f2937;
      color: white;
      padding: 20px;
    }

    h1 {
      margin: 0;
      font-size: 32px;
    }

    .game {
      max-width: 500px;
      margin: 25px auto;
      padding: 20px;
    }

    .score {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    .target {
      width: 300px;
      height: 300px;
      margin: auto;
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          #ffd700 0 18%,
          #e53935 18% 36%,
          #ffffff 36% 54%,
          #111827 54% 72%,
          #ffffff 72% 100%
        );
      border: 6px solid #333;
      cursor: crosshair;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      position: relative;
    }

    .message {
      margin-top: 20px;
      font-size: 20px;
      font-weight: bold;
      min-height: 30px;
    }

    button {
      margin-top: 20px;
      padding: 12px 25px;
      border: none;
      border-radius: 10px;
      background: #2563eb;
      color: white;
      font-size: 18px;
      cursor: pointer;
    }

    button:hover {
      background: #1d4ed8;
    }
  </style>
</head>

<body>

  <header>
    <h1>رَمْي 🏹</h1>
  </header>

  <div class="game">

    <div class="score">
      النقاط: <span id="score">0</span>
    </div>

    <div class="target" id="target"></div>

    <div class="message" id="message">
      اضغط على الهدف وارمِ السهم 🎯
    </div>

    <button onclick="resetGame()">إعادة اللعب</button>

  </div>

  <script>
    let score = 0;

    const target = document.getElementById("target");
    const scoreElement = document.getElementById("score");
    const message = document.getElementById("message");

    target.addEventListener("click", function(event) {

      const rect = target.getBoundingClientRect();

      const x = event.clientX - rect.left - rect.width / 2;
      const y = event.clientY - rect.top - rect.height / 2;

      const distance = Math.sqrt(x * x + y * y);
      const radius = rect.width / 2;

      let points = 0;

      if (distance < radius * 0.18) {
        points = 10;
        message.textContent = "🎯 إصابة ممتازة! +10";
      } 
      else if (distance < radius * 0.36) {
        points = 7;
        message.textContent = "🔥 إصابة قوية! +7";
      } 
      else if (distance < radius * 0.54) {
        points = 5;
        message.textContent = "👍 إصابة جيدة! +5";
      } 
      else if (distance < radius * 0.72) {
        points = 3;
        message.textContent = "🏹 أصبت الهدف! +3";
      } 
      else {
        points = 1;
        message.textContent = "😅 على الأطراف! +1";
      }

      score += points;
      scoreElement.textContent = score;
    });

    function resetGame() {
      score = 0;
      scoreElement.textContent = score;
      message.textContent = "اضغط على الهدف وارمِ السهم 🎯";
    }
  </script>

</body>
</html>
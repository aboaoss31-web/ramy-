<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رَمْي 🏹</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      color: #222;
      text-align: center;
    }

    header {
      background: #111827;
      color: white;
      padding: 25px 15px;
    }

    header h1 {
      margin: 0;
      font-size: 36px;
    }

    header p {
      margin: 8px 0 0;
      color: #d1d5db;
	   }


  .container {
    max-width: 900px;
    margin: auto;
    padding: 20px;
  }

  .card {
    background: white;
    border-radius: 18px;
    padding: 20px;
    margin-top: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }

  button {
    background: #111827;
    color: white;
    border: none;
    padding: 14px 25px;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 16px;
    box-sizing: border-box;
}

.result {
    margin-top: 20px;
    font-size: 20px;
    font-weight: bold;
}

.hidden {
    display: none;
}

@media (max-width: 600px) {
    .container {
        padding: 10px;
    }

    .card {
        padding: 15px;
    }

  button {
    width: 100%;
    border-radius: 12px;
    font-size: 18px;
    cursor: pointer;
}

button:hover {
    opacity: 0.9;
}

  input {
    width: 100%;
    padding: 14px;
    margin: 8px 0 15px;
    border: 1px solid #ddd;
    border-radius: 10px;
    font-size: 16px;
  }

  .score {
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    margin: 15px 0;
}
</style>
</head>

<body>

<header>
  <h1>رَمْي 🏹</h1>
  <p>تطبيق الرماية</p>
</header>

<div class="container">

  <div class="card">
    <h2>ابدأ الجولة 🎯</h2>

    <input type="number" id="arrows" placeholder="عدد الأسهم">

    <button onclick="startGame()">ابدأ</button>

    <div class="score">
      النقاط: <span id="score">0</span>
    </div>

    <button onclick="addScore()">إضافة نقطة 🎯</button>
  </div>

</div>

<script>
let score = 0;

function startGame() {
  score = 0;
  document.getElementById("score").textContent = score;
  alert("بدأت الجولة 🏹");
}

function addScore() {
    score++;
    document.getElementById("score").textContent = score;
}
 
function resetGame() {
    score = 0;

    document.getElementById("score").textContent = score;
    document.getElementById("result").textContent = "";
}

</script>

</body>
</html>
  
    .target {
      width: 260px;
      height: 260px;
      border-radius: 50%;
      margin: 20px auto;
      background:
        radial-gradient(circle,
        #111 0 12%,
        #fff 12% 25%,
        #2563eb 25% 40%,
        #fff 40% 55%,
        #ef4444 55% 70%,
        #fff 70% 82%,
        #22c55e 82% 100%);
      border: 5px solid #222;
    }

    button {
      width: 100%;
      padding: 15px;
      margin-top: 10px;
      border: none;
      border-radius: 12px;
      background: #111827;
      color: white;
      font-size: 18px;
      cursor: pointer;
    }

    button:hover {
      background: #374151;
    }

    .score {
      font-size: 28px;
      font-weight: bold;
      margin: 15px 0;
    }

    .result {
      margin-top: 15px;
      font-size: 18px;
      min-height: 25px;
    }
  </style>
</head>

<body>

  <header>
    <h1>رَمْي 🏹</h1>
    <p>تحدي الرماية</p>
  </header>

  <div class="container">
    <div class="card">

      <h2>🎯 الهدف</h2>

      <div class="target"></div>

      <div class="score">
        النقاط: <span id="score">0</span>
      </div>

      <button onclick="shoot()">
        🏹 ارمي السهم
      </button>

      <button onclick="resetGame()">
        🔄 إعادة اللعبة
      </button>

      <div class="result" id="result"></div>

    </div>
  </div>

  <script>
    let score = 0;

function shoot() {
    const points = Math.floor(Math.random() * 10) + 1;

    score += points;

    document.getElementById("score").textContent = score;

    document.getElementById("result").textContent =
document.getElementById("result").textContent =
    "أصبت الهدف! 🎯 +" + points + " نقاط";

        "🎯 أصبت الهدف! +" + points + " نقاط";
}

function resetGame() {
    score = 0;

    document.getElementById("score").textContent = score;

    document.getElementById("result").textContent =
        "🏹 ابدأ الرمي";
}
</script>






   
  

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رَمْي 🏹</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(180deg, #0f172a, #1e293b);
      color: white;
      text-align: center;
    }

    header {
      padding: 25px 15px;
    }

    h1 {
      font-size: 38px;
      margin: 10px 0;
    }

    .subtitle {
      color: #cbd5e1;
      font-size: 18px;
    }

    .game {
      max-width: 500px;
      margin: auto;
      padding: 20px;
    }

    .target {
      width: 300px;
      height: 300px;
      margin: 25px auto;
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          #111 0 10%,
          #facc15 10% 25%,
          #ef4444 25% 40%,
          #3b82f6 40% 55%,
          white 55% 70%,
          #111 70% 100%
        );
      border: 8px solid #475569;
      box-shadow: 0 10px 30px rgba(0,0,0,.5);
      cursor: crosshair;
    }

    button {
      border: none;
      border-radius: 14px;
      padding: 15px 30px;
      font-size: 20px;
      font-weight: bold;
      cursor: pointer;
      background: #facc15;
      color: #111827;
      margin: 8px;
    }

    button:active {
      transform: scale(.95);
    }

    .score {
      font-size: 28px;
      margin: 15px;
    }

    .message {
      font-size: 20px;
      min-height: 30px;
      color: #facc15;
    }
  </style>
</head>

<body>

  <header>
    <h1>رَمْي 🏹</h1>
    <div class="subtitle">لعبة التصويب على الهدف</div>
  </header>

  <main class="game">

    <div class="score">
      النقاط: <span id="score">0</span>
    </div>

    <div id="target" class="target"></div>

    <div class="message" id="message">
      اضغط على الهدف وابدأ الرمي 🎯
    </div>

    <button onclick="resetGame()">إعادة اللعب</button>

  </main>

  <script>
    let score = 0;

    const target = document.getElementById("target");
    const scoreText = document.getElementById("score");
    const message = document.getElementById("message");

    target.addEventListener("click", function(event) {

      const rect = target.getBoundingClientRect();

      const x = event.clientX - rect.left - rect.width / 2;
      const y = event.clientY - rect.top - rect.height / 2;

      const distance = Math.sqrt(x * x + y * y);

      let points;

      if (distance < 30) {
        points = 10;
        message.textContent = "إصابة في المركز 🔥 +10";
      } 
      else if (distance < 75) {
        points = 8;
        message.textContent = "ممتاز 🎯 +8";
      } 
      else if (distance < 120) {
        points = 6;
        message.textContent = "تصويب جيد 👍 +6";
      } 
      else if (distance < 165) {
        points = 4;
        message.textContent = "قريب 👌 +4";
      } 
      else {
        points = 2;
        message.textContent = "على الهدف 🏹 +2";
      }

      score += points;
      scoreText.textContent = score;
    });

    function resetGame() {
      score = 0;
      scoreText.textContent = score;
      message.textContent = "اضغط على الهدف وابدأ الرمي 🎯";
    }
  </script>

</body>
</html>
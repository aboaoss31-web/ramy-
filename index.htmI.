<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رَمْي 🏹</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: white;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 95%;
      max-width: 500px;
      text-align: center;
    }

    h1 {
      font-size: 42px;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #cbd5e1;
      margin-bottom: 25px;
    }

    .target {
      width: 300px;
      height: 300px;
      border-radius: 50%;
      margin: 20px auto;
      background:
        radial-gradient(
          circle,
          #facc15 0 18%,
          white 18% 36%,
          #ef4444 36% 54%,
          white 54% 72%,
          #3b82f6 72% 100%
        );
      border: 8px solid #111827;
      box-shadow: 0 10px 30px rgba(0,0,0,.4);
      position: relative;
    }

    .arrow {
      position: absolute;
      width: 6px;
      height: 120px;
      background: #111;
      left: 50%;
      top: 50%;
      transform-origin: bottom center;
      display: none;
    }

    .score-box {
      background: rgba(255,255,255,.1);
      padding: 18px;
      border-radius: 18px;
      margin-top: 20px;
    }

    .score {
      font-size: 38px;
      font-weight: bold;
      color: #facc15;
    }

    button {
      border: none;
      border-radius: 14px;
      padding: 15px 25px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      margin: 8px;
      background: #facc15;
      color: #111827;
    }

    button:hover {
      transform: scale(1.04);
    }

    .reset {
      background: #ef4444;
      color: white;
    }

    .message {
      margin-top: 15px;
      font-size: 20px;
      min-height: 30px;
    }
  </style>
</head>

<body>

  <div class="app">

    <h1>رَمْي 🏹</h1>

    <p class="subtitle">
      لعبة الرماية
    </p>

    <div class="target" id="target">
      <div class="arrow" id="arrow"></div>
    </div>

    <div class="score-box">
      <p>النقاط</p>
      <div class="score" id="score">0</div>
    </div>

    <button onclick="shoot()">🏹 ارمي السهم</button>

    <button class="reset" onclick="resetGame()">
      إعادة اللعب
    </button>

    <div class="message" id="message">
      اضغط على زر رمي السهم
    </div>

  </div>

  <script>

    let score = 0;

    function shoot() {

      const points = Math.floor(Math.random() * 10) + 1;

      score += points;

      document.getElementById("score").textContent = score;

      const arrow = document.getElementById("arrow");

      arrow.style.display = "block";

      const randomAngle = Math.floor(Math.random() * 360);

      arrow.style.transform =
        "translate(-50%, -50%) rotate(" +
        randomAngle +
        "deg)";

      let message = "";

      if (points >= 9) {
        message = "🔥 إصابة ممتازة!";
      } else if (points >= 6) {
        message = "👏 إصابة جيدة!";
      } else {
        message = "🏹 حاول مرة ثانية!";
      }

      document.getElementById("message").textContent =
        message + " +" + points + " نقاط";
    }

    function resetGame() {

      score = 0;

      document.getElementById("score").textContent = "0";

      document.getElementById("arrow").style.display = "none";

      document.getElementById("message").textContent =
        "ابدأ الرمي من جديد 🏹";
    }

  </script>

</body>
</html>